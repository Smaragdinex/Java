import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int a1 = sc.nextInt();
		int a2 = sc.nextInt();
		
		int b1 = sc.nextInt();
		int b2 = sc.nextInt();
		
		double x = (a1 + b1) / 2.0;
		double y = (a2 + b2) / 2.0;
		
		System.out.println("("+x+","+y+")");
		
		sc.close();
	}
}

import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		int m = sc.nextInt();
		
		int result = n - m;
		
		System.out.printf("There are %d candies, eat %d candies and still have %d left.\r\n", n, m, result);
		
		sc.close();
	}
	
}

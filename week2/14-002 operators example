import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int a = sc.nextInt();
		int b = sc.nextInt();
		
		calculate(a,b);
		
		sc.close();
	}
	
	public static void calculate(int a,int b)
	{
		System.out.println(a + "+" + b + "=" + (a+b));
		System.out.println(a + "-" + b + "=" + (a-b));
		System.out.println(a + "*" + b + "=" + a*b);
		System.out.println(a + "/" + b + "=" + a/b);
		System.out.println(a + "%" + b + "=" + a%b);
	}
}

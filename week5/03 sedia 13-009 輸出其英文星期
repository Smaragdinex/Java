import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int days = sc.nextInt();
		
		String s = switch(days){
			case 1 -> "Monday";
			case 2 -> "Tuesday";
			case 3 -> "Wednesday";
			case 4 -> "Thursday";
			case 5 -> "Friday";
			case 6 -> "Saturday";
			case 7 -> "Sunday";
			default -> "Input Error";
		};
		System.out.println(s);
		
		sc.close();
	}
}

import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int month = sc.nextInt();
		
		String s = switch(month){
			case 1,2 -> "Winter vacation";
			case 7,8 -> "Summer vacation";
			case 3,4,5,6,9,10,11,12 -> "In the semester";
			default -> "Input Error";
		};
		
		System.out.println(s);
		
		sc.close();
	
	}
}

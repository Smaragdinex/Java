import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		while(n-- >0)
		{
			int num = sc.nextInt();
			
			if(num < 1000 || num > 9999)
			{
				System.out.println("Failure Input");
				continue;
			}
			
			int[] count = new int[10];
			int temp = num;
			while(temp > 0)
			{
				int digit = temp % 10;
				count[digit]++;
				if(count[digit] > 2)
				{
					break;
				}
				temp /= 10;
			}
			
			int pairs = 0;
			boolean tooMany = false;
			for(int c : count)
			{
				if(c > 2)
				{
					tooMany = true;
					break;
				}
				if(c == 2) pairs++;
			}
			
			if(tooMany) System.out.println("No");
			
			else if(pairs == 1) System.out.println("Yes");
			
			else System.out.println("No");
		}
	}
}

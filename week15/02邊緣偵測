import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n  = sc.nextInt(), m = sc.nextInt();
		
		int[][] arr = new int[n][m];
		
		for(int i = 0; i < arr.length; i++)
		{
			for(int j = 0; j < arr[i].length; j++)
			{
				arr[i][j] = sc.nextInt();
 			}
		}
		
		char[][] result = new char[n][m];
		
		for(int i = 0; i < n; i++)
		{
			for(int j = 0; j < m; j++)
			{
				if(arr[i][j] == 0)
				{
					result[i][j] = '_';
				}
				else
				{
					boolean edge = false;
					if(i == 0 || arr[i - 1][j] == 0) edge = true;
					if(i == n - 1 || arr[i + 1][j] == 0) edge = true;
					if(j == 0 || arr[i][j - 1] == 0) edge = true;
					if(j == m - 1 || arr[i][j + 1] == 0) edge = true;
					
					if(edge) result[i][j] = '0';
					else result[i][j] = '_';
				}
			}
		}
		
		for(int i = 0; i < n; i++)
		{
			for(int j = 0; j < m; j++)
			{
				System.out.print(result[i][j]);
				System.out.print(" ");
			}
			System.out.println();
		}
		System.out.println();
	}
}

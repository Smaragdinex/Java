import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		double[][] score = new double[n][3];
		
		for(int i = 0; i < score.length; i++)
		{
			for(int j  = 0; j < score[i].length; j++)
			{
				score[i][j] = sc.nextDouble();
			}
		}
		
		double chinese = 0.0, english = 0.0, math = 0.0, sum = 0.0;
		
		for(int i = 0; i < score.length; i++)
		{
			chinese += score[i][0];
			english += score[i][1];
			math += score[i][2];
		}
		
		System.out.printf("%.2f %.2f %.2f %.2f", (chinese + english + math) / (n * 3.0), chinese/n, english/n, math/n);
	}
}

import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int[][] arr1 = new int[4][4], arr2 = new int[4][4], sum = new int[4][4];
		
		for(int i = 0; i < arr1.length; i++)
		{
			for(int j = 0; j < arr1[i].length; j++)
			{
				arr1[i][j] = sc.nextInt();
				arr2[i][j] = sc.nextInt();
			}
		}
		
		for(int i = 0; i < 4; i++)
		{
			for(int j = 0; j < 4; j++)
			{
				for(int k = 0; k < 4; k++)
				{
					sum[i][j] += arr1[i][k] * arr2[k][j];
				}
			}
		}
		
		System.out.println("Array a is:");
		printArray(arr1);
		System.out.println();
		System.out.println("Array b is:");
		printArray(arr2);
		System.out.println();
		System.out.println("Array a*b is:");
		printArray(sum);
	}
	
	static void printArray(int[][] a)
	{
		for(int[] row : a)
		{
			for(int val : row)
			{
				System.out.printf(" %d", val);
			}
			System.out.println();
		}
	}
}

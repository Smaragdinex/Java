class main
{
	public static void main(String[] args)
	{
		System.out.println("n:");
		
		int n = new java.util.Scanner(System.in).nextInt();
		
		long[] f = new long[n+1];
		
		f[0] = 0;
		f[1] = 1;
		
		for(int i = 2; i <= n; i++)
		{
			f[i] = f[i - 1] + f[i - 2];
		}
		for(int i = n; i >= 0; i--)
		{
			System.out.println("f(" + i + ")=" + f[i]);
		}
	}
}

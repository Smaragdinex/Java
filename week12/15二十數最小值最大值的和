import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int[] arr = new int[20];
		
		for(int i = 0; i < arr.length; i++)
		{
			arr[i] = sc.nextInt();
		}
		
		int min = arr[0], max = arr[0], minSum = 0, maxSum = 0;
		
		for(int x : arr)
		{
			if(x < min) min = x;
			if(x > max) max = x;
		}
		
		for(int x : arr)
		{
			if(x == min) minSum += x;
			if(x == max) maxSum += x;
		}
		System.out.printf("The MIN number is %d\r\nThe sum of all min number is %d\r\nThe MAX number is %d\r\nThe sum of all MAX number is %d\r\n",
		min,minSum,max,maxSum);
	}
}

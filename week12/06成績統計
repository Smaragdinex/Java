import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		double[][] arr = new double[n][3];
		
			for(int i = 0; i < n; i++)
			{
				for(int j = 0; j < arr[i].length; j++)
				{
					arr[i][j] = sc.nextDouble();
				}
			}
			double totalSum = 0.0;
			double[] avg = new double[3];
			
			for(int i = 0; i < n; i++)
			{
				for(int j = 0; j < arr[i].length; j++)
				{ 
					totalSum += arr[i][j];
					avg[j] += arr[i][j];
				}
			}
	
			System.out.printf("%.2f %.2f %.2f %.2f", totalSum /(n*3.0), avg[0]/n, avg[1]/ n, avg[2]/ n);
		
	}
}

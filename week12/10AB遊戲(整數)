import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int[] arr1 = new int[4], arr2 = new int[4];
		
		for(int i = 0; i < arr1.length; i++)
		{
			arr1[i] = sc.nextInt();
		}
		
		for(int i = 0; i < arr2.length; i++)
		{
			arr2[i] = sc.nextInt();
		}
		
		int A = 0, B = 0;
		
		for(int i = 0; i < 4; i++)
		{
			if(arr1[i] == arr2[i]) A++;
		}
		
		for(int i = 0; i < 4; i++)
		{
			for(int j = 0; j < 4; j++)
			{
				if(i != j && arr1[i] == arr2[j]) B++;
			}
		}
		
		System.out.printf("%dA%dB\r\n",A,B);
	}
}

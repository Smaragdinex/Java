import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int T = sc.nextInt();
		
		StringBuilder sb = new StringBuilder();
		
		for(int t = 0; t < T; t++)
		{
			int M = sc.nextInt();
			int[] x = new int[M];
			int[] y = new int[M];
		
		
			for(int i = 0; i < M; i++)
			{
				x[i] = sc.nextInt();
				y[i] = sc.nextInt();
			}
			
			int best = 0;
			for(int i = 0; i < M; i++)
			{
				for(int j = i + 1; j < M; j++)
				{
					int dx = x[i] - x[j];
					int dy = y[i] - y[j];
					int d2 = dx * dx + dy * dy;
					if(d2 > best) best = d2;
				}
			}
			
			sb.append(best).append("\n");
		}
		System.out.print(sb);
	}
}

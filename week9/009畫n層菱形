class main
{
	public static void main(String[] args)
	{
		int n = new java.util.Scanner(System.in).nextInt();
		
		for(int i = 1; i <= n; i+=2)
		{
			int space = (n - i) / 2;
			for(int s = 0; s < space; s++) System.out.print(" ");
			for(int k = 0; k < i; k++) System.out.print("*");
			System.out.println();
		}
		
		for(int i = n- 2; i >= 1; i-= 2)
		{
			int space = (n - i) / 2;
			for(int s = 0; s < space; s++) System.out.print(" ");
			for(int k = 0; k < i; k++) System.out.print("*");
			System.out.println();
		}
		
	}

import java.util.*;

class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int m = sc.nextInt(), n = sc.nextInt();
		
		int sum = 0;
		
		for(int i = 1; i <= m; i++)
		{
			int p = 1;
			for(int j = 0; j < n; j++)
			{
				p *= i;
			}
			sum += p;
		}
		
		System.out.println(sum);
	}
}

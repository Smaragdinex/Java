class main
{
	public static void main(String[] args)
	{
		int n = new java.util.Scanner(System.in).nextInt();
		int max = 2 * n -1;
		
		for(int i = 1; i <= max; i+=2)
		{
			int space = (max - i) / 2;
			for(int s = 0; s < space; s++) System.out.print(" ");
			for(int k = 0; k < i; k++) 
			{
				if(k == 0 || k == i - 1) System.out.print("*");
				else System.out.print(" ");
			}
			System.out.println();
		}
		
		for(int i = max - 2; i >= 1; i -= 2)
		{
			int space = (max - i) / 2;
			for(int s = 0; s < space; s++) System.out.print(" ");
			for(int k = 0; k < i; k++) 
			{
				if(k == 0 || k == i - 1) System.out.print("*");
				else System.out.print(" ");
			}
			System.out.println();
		}
	}
}

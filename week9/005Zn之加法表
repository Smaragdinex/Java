class main
{
	public static void main(String[] args)
	{
		int n = new java.util.Scanner(System.in).nextInt();
		
		for(int i = 0; i < n; i++)
		{
			for(int j = 0; j < n; j++)
			{
				if((i+j)% n > 9)
					System.out.printf("%5d", (i+j) % n);
				else
				System.out.printf("%4d", (i+j) % n);
			}
			System.out.println();
		}
	}
}

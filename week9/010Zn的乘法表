class main
{
	public static void main(String[] args)
	{
		System.out.println("please input number n:");
		
		int n = new java.util.Scanner(System.in).nextInt();
		
		for(int i = 0; i < n; i++)
		{
			for(int  j = 0; j < n; j++)
			{
				System.out.printf("%2d ", (i*j) % n);
			}
			System.out.println();
		}
		
		
	}
}

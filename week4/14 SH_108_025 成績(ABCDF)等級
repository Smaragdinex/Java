import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int score = sc.nextInt();
		
		String result = switch(score / 10){
			case 9,10 -> "A";
			case 8 -> "B";
			case 7 -> "C";
			case 6 -> "D";
			case 0,1,2,3,4,5 -> "F";
			default -> "Input Error";			
		};
		
		System.out.println(result);
		
		sc.close();
	}
}

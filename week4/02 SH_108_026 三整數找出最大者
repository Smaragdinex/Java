import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int[] arr = new int[3];
		
		for(int i = 0; i < arr.length; i++)
		{
			arr[i] = sc.nextInt();
		}
		
		int maxnum = Arrays.stream(arr).max().getAsInt();
		
		
		
		System.out.println(maxnum);
		
		sc.close();
	}
}

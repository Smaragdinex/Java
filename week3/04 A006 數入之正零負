import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int num = sc.nextInt();
		
		if(num > 0)
			System.out.print("N>0");
		else if(num < 0)
			System.out.print("N<0");
		else
			System.out.print("N=0");
		
		sc.close();
	}
}

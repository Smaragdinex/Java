import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int a = sc.nextInt();
		int b = sc.nextInt();
		int c = sc.nextInt();
		
		int[] s = {a,b,c};
		Arrays.sort(s);
		a = s[0];
		b = s[1];
		c = s[2];
		
		if( a + b <= c || a<= 0){
			System.out.println("not a triangle");
			return;
		}
		if(a == b && b == c)
			System.out.println("regular triangle");	
		if((a == b || b == c || a ==  c) && (a*a + b*b == c*c))
			System.out.println("isosceles right triangle");
		if(a == b || b == c || a == c)
			System.out.println("isosceles triangle");
		if (a * a + b *b == c*c)
			System.out.println("rectangular triangle");
		if(a * a + b *b < c*c)
			System.out.println("obtuse triangle");
		if(a*a + b*b > c*c)
			System.out.println("acute triangle");
			
		sc.close();
		
	}
}

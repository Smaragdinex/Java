import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		System.out.print("a(" + n +")=" + a(n));
		
		sc.close();
	}
	static double a(int n)
	{
		if(n == 1) return 1.0;
		return (double) n / (n + 1) * a(n - 1);
	}
}

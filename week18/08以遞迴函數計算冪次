import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int m = sc.nextInt();
		int n = sc.nextInt();
		
		System.out.println(power(m , n));
		
		
	}
	static long power(int m, int n)
	{
		if(n == 0) return 1;
		
		return m * power(m, n -1);
	}
}

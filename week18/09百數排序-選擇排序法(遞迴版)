import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int[] arr = new int[100];
		
		for(int i = 0; i < arr.length; i++)
			arr[i] = sc.nextInt();
		
		bubbleSort(arr, arr.length);
		
		printArray(arr, 0);
	}
	static void bubbleSort(int[] a, int n)
	{
		if(n == 1) return;
		
		bubblePass(a, 0 , n);
		
		bubbleSort(a, n - 1);
	}
	static void bubblePass(int[] a, int i, int n)
	{
		if(i == n - 1) return;
		
		if(a[i] > a[i + 1])
		{
			int temp = a[i];
			a[i] = a[i + 1];
			a[i + 1] = temp;
		}
		bubblePass(a, i + 1, n);
	}
	static void printArray(int[] a, int index)
	{
		if(index == a.length) return;
		
		System.out.printf("%d ", a[index]);
		
		printArray(a, index + 1);
	}
}

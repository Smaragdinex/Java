import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Input:");
		
		int n = sc.nextInt();
		
		System.out.println(n + "! = " + factorial(n));
		
		sc.close();
	}
	static long factorial(int n)
	{
		if(n == 0 || n == 1) return 1;
		return n * factorial(n-1);
	}
}

import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		System.out.print("f("+ n+ ")=" +f(n));
		
		sc.close();
	}
	static long f(int n)
	{
		if(n == 0) return 1;
		long sum = 0;
		for(int i = 0; i <= n - 1; i++)
		{
			sum += f(i) * f(n - 1 -i);
		}
		return sum;
	}
}

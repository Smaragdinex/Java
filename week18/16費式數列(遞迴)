import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc= new Scanner(System.in);
		
		int n  = sc.nextInt();
		
		System.out.println(F(n));
		
		sc.close();
	}
	static int F(int n)
	{
		if(n == 0) return 0;
		if(n == 1) return 1;
		return F(n-1) + F(n-2);
		 
	}
}

import java.util.*;

public class main
{
	public static void main(String args[])
	{
		Scanner in = new Scanner(System.in);
		int N;
		int K;
		N = in.nextInt();
	    K = in.nextInt();
		System.out.println(C(N,K));
	}
	static int C(int n, int k)
	{
		if(k == 0 || k == n) return 1;
		
		return C(n - 1, k - 1) + C(n - 1, k);
	}
}

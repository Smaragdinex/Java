import java.util.*;

public class main
{
	public static void main(String[] args)
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		
		System.out.println(minSteps(n));
	}
	
	static int minSteps(int n)
	{
		if(n == 1) return 0;
		
		if(n % 2 == 0)
		{
			return 1 + minSteps(n / 2);
		}
		
		return 1 + Math.min(minSteps(n - 1), minSteps(n + 1));
	}
}

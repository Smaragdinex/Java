import java.util.*;

class main
{	
	public static void main(String[] args){
		Scanner in = new Scanner(System.in);
		int k=in.nextInt();
		int n=in.nextInt();
		
		System.out.println(cal(n, k));
		
	}
	
	static int cal(int n , int k)
	{
		int sum = 0;
		for(int i =1; i <= n; i++)
		{
			long p = 1;
			for(int j = 0; j < k; j++)
			{
				p*= i;
			}
			sum+= p;
		}
		
		return sum;
	}
}

class main
{
	public static void main(String[] args)
	{
		int n = new java.util.Scanner(System.in).nextInt();
		
		for(int a = 1; a <= n; a++)
		{
			for(int b = a + 1; b <= n; b++)
			{
				for(int c = b + 1; c < n; c++)
				{
					if(a*a + b*b == c*c && gcd(gcd(a,b),c) == 1) System.out.printf("%d, %d, %d\r\n",a,b,c);
				}
				
			}
		}
	}
	
	static int gcd(int x, int y)
	{
		return y == 0 ? x : gcd(y, x%y);
	}
}
